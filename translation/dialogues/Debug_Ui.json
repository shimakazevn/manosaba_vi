      "objection_links": []
    },
    {
      "id": "~73174a9",
      "speaker_tag": "; > @print |#~73174a9| !waitInput",
      "ja": "エマたち一行は、<br>何より証拠を得られそうな殺害現場へと向かった。",
      "zh": "",
      "vi": "Kiểm tra hệ thống kịch bản.",
      "objection_links": []
    },
    {
      "id": "~d42ae7d6",
      "speaker_tag": "; > @print |#~d42ae7d6| !waitInput",
      "ja": "足取りは重たい。<br>ノアの死体を直視したくない、という気持ちが大きい。",
      "zh": "",
      "vi": "Kiểm tra hệ thống kịch bản.",
      "objection_links": []
    },
    {
      "id": "~3563838",
      "speaker_tag": "; > @print |#~3563838| !waitInput",
      "ja": "そんな中、シェリーはスキップしている。",
      "zh": "",
      "vi": "Kiểm tra hệ thống kịch bản.",
      "objection_links": []
    },
    {
      "id": "~916e99d2",
      "speaker_tag": "; > @print \"|#~916e99d2|\" author:Hanna !waitInput",
      "ja": "「ちょっとあなた、神経どうにかしてるんじゃありません？<br>　よくスキップなんかできますわね」",
      "zh": "",
      "vi": "Kiểm tra hệ thống kịch bản.",
      "objection_links": []
    },
    {
      "id": "~9fd5abf2",
      "speaker_tag": "; > @print \"|#~9fd5abf2|\" author:Sherry !waitInput",
      "ja": "「ええっ、私気遣いの子ですよぉ？<br>　学校でも、みんなが避けてるの察知して距離あけてましたもん」",
      "zh": "",
      "vi": "Kiểm tra hệ thống kịch bản.",
      "objection_links": []
    },
    {
      "id": "~e0c9abb4",
      "speaker_tag": "; > @print |#~e0c9abb4| author:Hanna !waitInput",
      "ja": "「ナチュラルにハブられてません？」",
      "zh": "",
      "vi": "Kiểm tra hệ thống kịch bản.",
      "objection_links": []
    },
    {
      "id": "~5b121a55",
      "speaker_tag": "; > @print \"|#~5b121a55|\" author:Sherry !waitInput",
      "ja": "「そんなことないですって！<br>　みんな【妖精さん】って親しみを込めて呼んでくれてました！」",
      "zh": "",
      "vi": "Kiểm tra hệ thống kịch bản.",
      "objection_links": []
    },
    {
      "id": "~854aba99",
      "speaker_tag": "; > @print |#~854aba99| author:Hanna !waitInput",
      "ja": "「それ絶対良い意味じゃないですわ」",
      "zh": "",
      "vi": "Kiểm tra hệ thống kịch bản.",
      "objection_links": []
    },
    {
      "id": "~3cff067f",
      "speaker_tag": "; > @print \"|#~3cff067f|\" author:Ema !waitInput",
      "ja": "（こんな時だけど……<br>　ハンナちゃんが少し元気を取り戻してくれて良かった）",
      "zh": "",
      "vi": "Kiểm tra hệ thống kịch bản.",
      "objection_links": []
    },
    {
      "id": "~3510ea53",
      "speaker_tag": "; > @print |#~3510ea53| !waitInput",
      "ja": "２人のやり取りを横に、エマはホッとする。<br>とはいえ、ノアの房が近づけば近づくほど気が重くなる。",
      "zh": "",
      "vi": "Kiểm tra hệ thống kịch bản.",
      "objection_links": []
    },
